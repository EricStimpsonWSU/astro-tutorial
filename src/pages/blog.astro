---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const pageTitle = "Astro Learning Blog"
---

<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navigation />

    <h1>My Astro Site</h1>
    <h1>{pageTitle}</h1>
    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
      <li><a href={`${import.meta.env.BASE_URL}/blog/post1`}>Post 1</a></li>
      <li><a href={`${import.meta.env.BASE_URL}/blog/post2`}>Post 2</a></li>
      <li><a href={`${import.meta.env.BASE_URL}/blog/post3`}>Post 3</a></li>
    </ul>
    <Footer />
  </body>
</html>