---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const pageTitle = "Astro Learning Blog"
---

<BaseLayout pageTitle={pageTitle}>

    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
      {posts.map((p) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/blog/${p.id}`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
      <li><a href={`${import.meta.env.BASE_URL}/posts/post1`}>Post 1</a></li>
      <li><a href={`${import.meta.env.BASE_URL}/posts/post2`}>Post 2</a></li>
      <li><a href={`${import.meta.env.BASE_URL}/posts/post3`}>Post 3</a></li>
    </ul>
</BaseLayout>