---
const pageTitle = "About Me";

const identity = {
  firstName: "Eric",
  country: "US of A",
  occupation: "Gardener",
  hobbies: ["this", "that", "other"]
}

const skills = ["HTML", "CSS"]

const happy = true;
const finished = false;
const goal = 3
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href={import.meta.env.BASE_URL}>Home</a>
    <a href={`${import.meta.env.BASE_URL}/about`}>About</a>
    <a href={`${import.meta.env.BASE_URL}/blog`}>Blog</a>
    
    <h1>My Astro Site</h1>
    <h1>{pageTitle}</h1>
    <h2>... and my new Astro site!</h2>

    <p>I am working through Astro's introductory tutorial.</p>

    <p>This site will update, check back later.</p>
    <p>Here are a few facts about me:</p>
    <ul>
      <li>My name is {identity.firstName}.</li>
      <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
      {identity.hobbies.length >= 2 &&
        <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
      }
    </ul>
    <p>My skills are:</p>
    <ul>
      {skills.map((skill) => <li>{skill}</li>)}
    </ul>

    {happy && <p>I am happy!</p>}
    {finished ? <p>I am finished with the tutorial.</p> : <p>I am not finished with the tutorial.</p>}
    {goal === 3 ? <p>My goal is to finish in 3 days.</p> : <p>My goal is not to finish in 3 days.</p>}
  </body>
</html>